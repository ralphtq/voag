@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dtype: <http://www.linkedmodel.org/schema/dtype#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/voag/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

void:Dataset a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "VOID Dataset"^^xsd:string ;
    dcterms:description "A set of RDF triples that are published, maintained or aggregated by a single provider."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:GovernedObject .

voag:Accreditation a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Accreditation"^^xsd:string ;
    dcterms:description "A minimal representation of accredidation"^^xsd:string ;
    voag:wasInfluencedBy "http://en.wikipedia.org/wiki/Accreditation"^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Qualifier .

voag:AdditionalClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Additional clause"^^xsd:string ;
    rdfs:subClassOf voag:Clause .

voag:AdjunctClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Adjunct clause"^^xsd:string ;
    rdfs:subClassOf voag:Clause ;
    sh:property voag:AdjunctClause-withRespectTo .

voag:AdministrativeEvent a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Administrative Event"^^xsd:string ;
    dcterms:description "An event that is associated with the admistration aspect of governance. Typically these are curation events."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Event .

voag:ApprovalEvent a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Approval Event"^^xsd:string ;
    dcterms:description "An approval."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Event ;
    sh:not [ sh:class voag:RejectionEvent ] .

voag:ApprovalProcess a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Approval Process"^^xsd:string ;
    dcterms:description "A minimal representation of an approval process."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:GovernanceProcess .

voag:ArchivalEvent a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Archival Event"^^xsd:string ;
    dcterms:description "An archival occurrence."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Event .

voag:AttorneyFeesClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Attorney fees clause"^^xsd:string ;
    rdfs:subClassOf voag:Clause .

voag:Attribution a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Attributed Source"^^xsd:string ;
    dcterms:description "An 'Attribution' specifies how credit should be given when citing the creators of a piece of work. Attribution must use the specified attribution text and optionally use logos that are provided in the attribution details below., with the names of points of contact."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Qualifier ;
    sh:property voag:Attribution-hasLogo,
        voag:Attribution-name,
        voag:Attribution-pointOfContact,
        voag:Attribution-url .

voag:AttributionLogo a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Attribution logo"^^xsd:string ;
    dcterms:description "self-explanatory"^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Logo .

voag:AttributionRightsClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Attribution rights clause"^^xsd:string ;
    rdfs:subClassOf voag:Clause .

voag:Catalog a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Catalog"^^xsd:string ;
    dcterms:description "An index to a set of resources "^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:GovernedObject ;
    sh:property voag:Catalog-hasLogo .

voag:ChangeFrequency a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Change frequency"^^xsd:string ;
    dcterms:description "self-explanatory"^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:EnumeratedValue ;
    sh:in ( voag:Never voag:Daily voag:Weekly voag:BiWeekly voag:Monthly voag:BiMonthly voag:Quarterly voag:BiQuarterly voag:Annually voag:UncertainFrequency ) .

voag:ChangeManagementProcess a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Change Management Process"^^xsd:string ;
    dcterms:description "A minimal representation of a change management process."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:GovernanceProcess .

voag:ChangeType a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Change type"^^xsd:string ;
    dcterms:description "Change Type provides an indicator for how an artifact has or will change in the future. This indicator is important to understanding the stability of an ontology."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:EnumeratedValue .

voag:Clause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "License clause"^^xsd:string ;
    sh:property voag:Clause-clauseNumber,
        voag:Clause-description,
        voag:Clause-title .

voag:ConcurrenceEvent a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Concurrence event"^^xsd:string ;
    dcterms:description "A concurrence."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Event ;
    sh:not [ sh:class voag:NonConcurrenceEvent ] .

voag:ConfidentialityLevel a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Confidentiality level"^^xsd:string ;
    dcterms:description "An enumerated codelist for values thath pertain to the security of a set of resources, or a resource. In 'lmc' an ontology can carry a property to denote its confidentiality."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:EnumeratedValue .

voag:CopyrightGrantClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Cpyright grant clause"^^xsd:string ;
    vaem:description "A permission that a Licensor grants."^^xsd:string ;
    rdfs:subClassOf voag:GrantClause .

voag:CreativeCommonsJurisdiction a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Creative commons jurisdiction"^^xsd:string,
        "Creative Commons Jurisdiction"@en-US ;
    dcterms:description "the legal jurisdiction of a license"@en-US ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> .

voag:CreativeCommonsPermission a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Creative Commons Permission"@en-US ;
    dcterms:description "An action that may or may not be allowed or desired"@en-US ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:EnumeratedValue .

voag:CreativeCommonsProhibition a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Creative Commons Prohibition"@en-US ;
    dcterms:description "something you may be asked not to do"@en-US ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:EnumeratedValue .

voag:CreativeCommonsRequirement a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Requirement"@en-US ;
    dcterms:description "An action that may or may not be requested of you"@en-US,
        "an action that may or may not be requested of you"@en-US ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:EnumeratedValue .

voag:CreativeCommonsWork a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Creative commons work"^^xsd:string,
        "Creative Commons Work"@en-US ;
    dcterms:description "A potentially copyrightable work"@en-US ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    sh:property voag:CreativeCommonsWork-morePermissions,
        voag:CreativeCommonsWork-url,
        voag:CreativeCommonsWork-useGuidelines .

voag:DefinitionClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Definition clause"^^xsd:string ;
    rdfs:subClassOf voag:Clause .

voag:DeletionEvent a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Deletion Event"^^xsd:string ;
    dcterms:description "A deletion."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Event .

voag:DesignatedGovernanceRole a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Designated Governance Role"^^xsd:string ;
    dcterms:description "An\"Assigned Role\" with the following instance(s): \"Assurer\", \"Project Management\", \"Resource & Process Policy\", \"Technical Definitions\", \"User\", \"Verifier\"."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    sh:property voag:DesignatedGovernanceRole-hasGraphRole,
        voag:DesignatedGovernanceRole-performedBy .

voag:DisclaimerClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Disclaimer clause"^^xsd:string ;
    rdfs:subClassOf voag:Clause .

voag:DistributionClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Distribution Clause"^^xsd:string ;
    dcterms:description "A Distiribution Clause covers the use, distribution, or communication of the Original Work or Derivative Works in any way such that the Original Work or Derivative Works may be used by anyone other than You, whether those works are distributed or communicated to those persons or made available as an application intended for use over a network."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Clause .

voag:Document a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Document"^^xsd:string ;
    dcterms:description "A minimal representaiton of a 'document'."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    sh:property voag:Document-dateCreated,
        voag:Document-description,
        voag:Document-lastUpdated,
        voag:Document-name,
        voag:Document-title,
        voag:Document-url .

voag:EnumeratedValue a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Metadata Enumerated value"^^xsd:string ;
    dcterms:description "The base class in LMC for enumerated values"^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf dtype:EnumeratedValue .

voag:Event a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Event"^^xsd:string ;
    dcterms:description "A governance-related event."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    sh:property voag:Event-description,
        voag:Event-endDate,
        voag:Event-eventDate,
        voag:Event-id,
        voag:Event-instigatedBy,
        voag:Event-name,
        voag:Event-startDate .

voag:ExclusionClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Exclusion lclause"^^xsd:string ;
    rdfs:subClassOf voag:Clause .

voag:Figure a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Figure"^^xsd:string ;
    dcterms:description "An illustration of some kind."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Image ;
    sh:property voag:Figure-imageMap .

voag:GeneralProvisionsClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "General provisions clause"^^xsd:string ;
    rdfs:subClassOf voag:Clause .

voag:Governance a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Governance"^^xsd:string ;
    dcterms:description "Governance is mainly concerned with how an artifact is provisioned and managed over its lifecycle. Governance also concerns the status tracking and processes that need to exist on information objects and services for a successful initiaitve, mission, program, or project. Such governance needs to outline the relationships between all internal and external groups involved, describe the proper flow of information regarding to all stakeholders, ensure the appropriate review of issues encountered and ensure that required approvals and direction are obtained at each appropriate stage."^^xsd:string ;
    voag:wasInfluencedBy "http://en.wikipedia.org/wiki/Governance"^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Qualifier ;
    sh:property voag:Governance-frequencyOfChange,
        voag:Governance-hasAnticipatedChangeType,
        voag:Governance-hasApplicableDocument,
        voag:Governance-hasApprovalStatus,
        voag:Governance-hasConfidentiality,
        voag:Governance-hasGovernanceEvent,
        voag:Governance-hasIssue,
        voag:Governance-hasNormativeDocument,
        voag:Governance-hasOwner,
        voag:Governance-hasProtocol,
        voag:Governance-hasReferenceDocument,
        voag:Governance-isFOSS,
        voag:Governance-isITAR,
        voag:Governance-supercedes .

voag:GovernanceEvent a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Governance Event"^^xsd:string ;
    dcterms:description "Another event that is associated with governance."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Event .

voag:GovernanceProcess a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Governance Process"^^xsd:string ;
    dcterms:description "A minimal representaton of governance process."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Process .

voag:GovernanceProtocol a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Governance Protocol"^^xsd:string ;
    dcterms:description "Governance is used  to mean the processes that need to exist for a successful initiaitve, mission, program, or project. Such governance needs to outline the relationships between all internal and external groups involved, describe the proper flow of information regarding to all stakeholders, ensure the appropriate review of issues encountered and ensure that required approvals and direction for a 'GovernedEntity' is obtained at each appropriate stage."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Qualifier ;
    sh:property voag:GovernanceProtocol-hasApprovalProcess,
        voag:GovernanceProtocol-hasChangeManagementProcess,
        voag:GovernanceProtocol-hasIssueResolutionProcess,
        voag:GovernanceProtocol-hasNormativeDocument,
        voag:GovernanceProtocol-hasProcess,
        voag:GovernanceProtocol-id,
        voag:GovernanceProtocol-isApprovedBy,
        voag:GovernanceProtocol-isGovernedBy,
        voag:GovernanceProtocol-isInterestOf,
        voag:GovernanceProtocol-mayNeedConcurrenceFrom,
        voag:GovernanceProtocol-reviewedBy .

voag:GovernanceRole a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Governance Role"^^xsd:string ;
    dcterms:description "A \"Role\" with the following instance(s): \"authorizer\", \"steward\", \"submitter\"."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:EnumeratedValue .

voag:GovernedObject a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Governed Object"^^xsd:string ;
    dcterms:description "An abstract class for all governed entities. This is a subclass of the provenance ontology 'entity'."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf prov:Entity ;
    sh:property voag:GovernedObject-dateCreated,
        voag:GovernedObject-description,
        voag:GovernedObject-documentedAt,
        voag:GovernedObject-hasGovernance,
        voag:GovernedObject-hasProvenance,
        voag:GovernedObject-id,
        voag:GovernedObject-lastUpdated,
        voag:GovernedObject-name,
        voag:GovernedObject-normativeURL,
        voag:GovernedObject-revision,
        voag:GovernedObject-title,
        voag:GovernedObject-url .

voag:GovernedService a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Governed service"^^xsd:string ;
    dcterms:description "A miniminal representaiton of a governed service."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Service ;
    sh:not [ sh:class voag:NonGovernedService ] .

voag:GrantClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Grant clause"^^xsd:string ;
    vaem:description "A grant is a permission to perform some action."^^xsd:string ;
    rdfs:subClassOf voag:Clause ;
    sh:property voag:GrantClause-description .

voag:Graph a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Graph"^^xsd:string ;
    dcterms:description "A set of RDF triples in an ontology graph specified according to VOAG."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf void:Dataset ;
    sh:property voag:Graph-aspectScope,
        voag:Graph-attributionText,
        voag:Graph-curatedGraphURI,
        voag:Graph-disciplineScope,
        voag:Graph-domainScope,
        voag:Graph-downloads,
        voag:Graph-hasGraphRole,
        voag:Graph-hasLicenseType,
        voag:Graph-hasLogo,
        voag:Graph-namespace,
        voag:Graph-namespacePrefix,
        voag:Graph-urlOfRDFfile,
        voag:Graph-urlOfTurtleFile,
        voag:Graph-viewpointScope,
        voag:Graph-withAttributionTo .

voag:Icon a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Icon"^^xsd:string ;
    dcterms:description "A logo of some kind"^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Image .

voag:Image a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Image"^^xsd:string ;
    dcterms:description "Image is a class for figures, pictures, logos, and icons  of various kinds"^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    sh:property voag:Image-caption,
        voag:Image-height,
        voag:Image-image,
        voag:Image-width .

voag:Issue a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Issue"^^xsd:string ;
    dcterms:description "Captures issues such as raising of an issue related to a particular entity in a registry"^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    sh:property voag:Issue-description,
        voag:Issue-disposition,
        voag:Issue-dispositionStatus,
        voag:Issue-hasStatus,
        voag:Issue-id,
        voag:Issue-priority,
        voag:Issue-relatedIssue,
        voag:Issue-title,
        voag:Issue-userID .

voag:IssueResolutionProcess a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Issue Resolution Process"^^xsd:string ;
    dcterms:description "A minimal representation of an issue resolution process."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:GovernanceProcess .

voag:IssueStatus a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Issue Status"^^xsd:string ;
    dcterms:description "The status of an issue: \"Closed\", \"Deferred\", \"Non issue\", \"Open\", \"Resolved\"."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:EnumeratedValue .

voag:JuristricationClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Juristrication clause"^^xsd:string ;
    rdfs:subClassOf voag:Clause .

voag:License a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "License Model"^^xsd:string ;
    dcterms:description "A License describes the licensing conditions associated with a software artifact."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:GovernedObject ;
    sh:property voag:License-DistributionClause,
        voag:License-acronym,
        voag:License-compatibleWith,
        voag:License-deprecated,
        voag:License-derivedFrom,
        voag:License-hasClause,
        voag:License-image,
        voag:License-incompatibleWith,
        voag:License-jurisdiction,
        voag:License-legalcode,
        voag:License-permits,
        voag:License-prohibits,
        voag:License-requires,
        voag:License-url .

voag:LimitationOfLiabilityClause a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Limitation of liability clause"^^xsd:string ;
    rdfs:subClassOf voag:Clause .

voag:Logo a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Logo"^^xsd:string ;
    dcterms:description "Logo is ..."^^xsd:string ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:subClassOf voag:Image .

voag:Maturity a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Maturity"^^xsd:string ;
