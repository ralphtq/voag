voag:MODIFIED_BSD_LICENSE
  rdf:type voag:LicenseModel ;
  dct:description "This is the original BSD license, modified by removal of the advertising clause. It is a simple, permissive non-copyleft free software license, compatible with the GNU GPL. If you want a simple, permissive non-copyleft free software license, the modified BSD license is a reasonable choice. However, it is risky to recommend use of “the BSD license”, because confusion could easily occur and lead to use of the flawed original BSD license. To avoid this risk, you can suggest the X11 license instead. The X11 license and the revised BSD license are more or less equivalent. This license is sometimes referred to as the 3-clause BSD license."^^xsd:string ;
  voag:url "http://www.xfree86.org/3.3.6/COPYRIGHT2.html#5" ;
  vaem:acronym "ModifiedBSD"^^xsd:string ;
