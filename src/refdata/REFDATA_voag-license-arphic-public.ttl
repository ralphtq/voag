  rdfs:label "title" ;
  rdfs:range xsd:string .

dcterms:description
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

voag:ARPHIC-PUBLIC-LICENSE
  a voag:License ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-arphic-public> ;
  rdfs:label "Arphic Public License" ;
  vaem:acronym "Arphic" ;
  vaem:description "This is a copyleft free software license, incompatible with the GPL. Its normal use is for fonts, and in that use, the incompatibility does not cause a problem." ;
  voag:compatibleWith voag:GNU-GPL ;
  voag:url "http://ftp.gnu.org/gnu/non-gnu/chinese-fonts-truetype/LICENSE" .

voag:GMD_VOAG-LICENSE-ARPHIC-PUBLIC
  a vaem:GraphMetaData ;
  dcterms:author "Ralph Hodgson" ;
  dcterms:created "2026-11-18"^^xsd:date ;
  dcterms:description "Arphic Public License, described in the Vocabulary Of Attribution and Governance (VOAG)." ;
