voag:EUPL_V1PT1
  a voag:License ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-eupl-v1pt1> ;
  rdfs:label "European Union Public License (EUPL) version 1.1" ;
  vaem:acronym "EUPL" ;
  vaem:description "This is a free software license. By itself, it has a copyleft comparable to the GPL's. However, it allows recipients to distribute the work under the terms of other selected licenses, and some of those—the Eclipse Public License and the Common Public License in particular—only provide a weaker copyleft. Thus, developers can't rely on this license to provide a strong copyleft. The EUPL is compatible with GPLv2, because that is listed as one of the alternative licenses that recipients may use. However, it is incompatible with GPLv3, because recipients are not given permission to use GPLv3's terms, and the EUPL's copyleft conflicts with GPLv3's." ;
  voag:compatibleWith voag:GNU-GPL_V2 ;
  voag:incompatibleWith voag:GNU-GPL_V3 ;
  voag:url "http://www.osor.eu/eupl" .

