voag:GMD_VOAG-LICENSES
  a vaem:GraphMetaData ;
  dcterms:author "Ralph Hodgson" ;
  dcterms:created "2012-11-01"^^xsd:date ;
  dcterms:modified "2015-04-02"^^xsd:date ;
  dcterms:subject "Licensing, Attribution,  Governance and Provenance" ;
  dcterms:title "Vocabulary Of Attribution and Governance (VOAG) Licenses  - Version 2.0" ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag> ;
  rdfs:label "Software Licenses in the \"Vocabulary Of Attribution and Governance (VOAG)\", version 2.0" ;
  vaem:description """
<p>VOAG stands for <i>Vocabulary Of Attribution and Governance</i>.
In this graph VOAG is used to describe a number of common license types.
</p><p>A license in VOAG is a <code class="boxed">voag:GovernedObject</code> with clauses representing what the license grants such as modification and distribution rights, disclaimers, liabilities, warranties and other rights.
The model of licenses places importance on expressing compatibility between licenses.
Where a license requires attribution, VOAG provides resources that allow the attribution should be made.
Provenance is defined in terms of source and pedigree.
</p><p>A minimal model of governance is provided based on how issues, releases and changes are managed.
</p>
"""^^rdf:HTML ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:hasLicenseType voag:CC-SHAREALIKE_3PT0-US ;
  vaem:hasOwner vaem:LinkedModels ;
  vaem:hasSteward vaem:LinkedModels ;
  vaem:lastUpdated "2012-11-01"^^xsd:date ;
  vaem:latestPublishedVersion "http://voag.linkedmodel.org/2.0/doc/2015/REFDATA_voag-licenses-v2.0.html"^^xsd:anyURI ;
  vaem:logo "http://www.linkedmodel.org/lib/lm/images/logos/voag_logo_360x110.png"^^xsd:anyURI ;
  vaem:name "voag" ;
  vaem:namespace "http://voag.linkedmodel.org/voag/" ;
  vaem:namespacePrefix "voag" ;
  vaem:owner "Linkedmodels" ;
  vaem:previousPublishedVersion "http://linkedmodel.org/doc/voag/1.0/"^^xsd:anyURI ;
  vaem:rdfxmlFileURL "http://voag.linkedmodel.org/2.0/refdata/REFDATA_voag-licenses-v2.0.rdf"^^xsd:anyURI ;
  vaem:revision "2.0" ;
  vaem:title "VOAG Software Licenses  version 2.0" ;
  vaem:turtleFileURL "http://voag.linkedmodel.org/2.0/refdata/REFDATA_voag-licenses-v2.0.ttl"^^xsd:anyURI ;
  vaem:url "http://voag.linkedmodel.org/2.0/vocab/voag"^^xsd:anyURI ;
  vaem:withAttributionTo voag:LinkedModelsAttribution .

