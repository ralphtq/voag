voag:documentedAt a rdf:Property ;
    rdfs:label "documented at"^^xsd:string ;
    dcterms:description "The property 'vaem:documentedAt' is intended for general use as the name implies.  In some cases the property could have scalar values and in other cases may need to refer to a first class concept that holds more information about a documentation resource.  For this reason, the  type of this property is set as 'rdf:Property' and the property is rangeless."^^xsd:string ;
