<http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-open-software>
  a owl:Ontology ;
  owl:imports <http://voag.linkedmodel.org/$$VERSION$$/schema/shacl/voag> ;
  vaem:hasGraphMetadata voag:GMD_VOAG-LICENSE-OPEN-SOFTWARE .

