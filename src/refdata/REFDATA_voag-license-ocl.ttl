@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/voag/> .

<http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-ocl>
  a owl:Ontology ;
  owl:imports <http://voag.linkedmodel.org/$$VERSION$$/schema/shacl/voag> ;
  vaem:hasGraphMetadata voag:GMD_VOAG-LICENSE-OCL .

dcterms:author
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "author" ;
  rdfs:range xsd:string .

dcterms:created
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "created" ;
  rdfs:range xsd:date .

dcterms:modified
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "modified" ;
  rdfs:range xsd:date .

dcterms:subject
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

dcterms:title
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "title" ;
  rdfs:range xsd:string .

dcterms:description
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

voag:GMD_VOAG-LICENSE-OCL
  a vaem:GraphMetaData ;
  dcterms:author "Ralph Hodgson" ;
  dcterms:created "2026-11-18"^^xsd:date ;
  dcterms:description "Open Content License, Version 1.0, described in the Vocabulary Of Attribution and Governance (VOAG)." ;
  dcterms:modified "$$RELEASE_DATE$$"^^xsd:date ;
  dcterms:subject "Licensing, Attribution, Governance and Provenance" ;
  dcterms:title "VOAG License: Open Content License, Version 1.0 - Version $$VERSION$$" ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-ocl> ;
  rdfs:label "VOAG License: Open Content License, Version 1.0 - Version $$VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:hasLicenseType voag:CCBY-4PT0-LICENSE ;
  vaem:hasOwner vaem:LinkedModels ;
  vaem:hasSteward vaem:LinkedModels ;
  vaem:name "voag" ;
  vaem:namespace "http://voag.linkedmodel.org/voag/" ;
  vaem:namespacePrefix "voag" ;
  vaem:owner "Linkedmodels" ;
  vaem:revision "$$VERSION$$" ;
  vaem:title "VOAG License: Open Content License, Version 1.0 - Version $$VERSION$$" ;
  vaem:turtleFileURL "http://voag.linkedmodel.org/$$VERSION$$/refdata/REFDATA_voag-license-ocl-v$$VERSION$$.ttl"^^xsd:anyURI ;
  vaem:withAttributionTo voag:LinkedModelsAttribution .

voag:OCL
  a voag:License ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-ocl> ;
  rdfs:label "Open Content License, Version 1.0" ;
  vaem:acronym "OCL" ;
  vaem:description "This license does not qualify as free, because there are restrictions on charging money for copies. GNU recommend you do not use this license. Note that this license is not the same as the Open Publication License. The practice of abbreviating “Open Content License” as “OPL” leads to confusion between them. For clarity, it is better not to use the abbreviation “OPL” for either license. It is worth spelling their names in full to make sure people understand what you say." ;
  voag:incompatibleWith voag:GNU-FDL ;
  voag:incompatibleWith voag:OPL ;
  voag:url "http://opencontent.org/opl.shtml" .


