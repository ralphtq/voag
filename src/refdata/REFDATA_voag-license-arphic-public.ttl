voag:ARPHIC-PUBLIC-LICENSE
  a voag:License ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-arphic-public> ;
  rdfs:label "Arphic Public License" ;
  vaem:acronym "Arphic" ;
  vaem:description "This is a copyleft free software license, incompatible with the GPL. Its normal use is for fonts, and in that use, the incompatibility does not cause a problem." ;
  voag:compatibleWith voag:GNU-GPL ;
  voag:hasClause voag:CLS_ARPHIC-PUBLIC-00 ;
  voag:hasClause voag:CLS_ARPHIC-PUBLIC-01 ;
  voag:hasClause voag:CLS_ARPHIC-PUBLIC-02 ;
  voag:hasClause voag:CLS_ARPHIC-PUBLIC-03 ;
  voag:hasClause voag:CLS_ARPHIC-PUBLIC-04 ;
  voag:hasClause voag:CLS_ARPHIC-PUBLIC-05 ;
  voag:hasClause voag:CLS_ARPHIC-PUBLIC-06 ;
  voag:hasClause voag:CLS_ARPHIC-PUBLIC-07 ;
