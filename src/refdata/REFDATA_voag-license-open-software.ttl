  voag:hasClause voag:CLS_OPEN-SOFTWARE-08 ;
  voag:hasClause voag:CLS_OPEN-SOFTWARE-09 ;
  voag:hasClause voag:CLS_OPEN-SOFTWARE-10 ;
  voag:hasClause voag:CLS_OPEN-SOFTWARE-11 ;
  voag:hasClause voag:CLS_OPEN-SOFTWARE-12 ;
  voag:hasClause voag:CLS_OPEN-SOFTWARE-13 ;
  voag:hasClause voag:CLS_OPEN-SOFTWARE-14 ;
  voag:hasClause voag:CLS_OPEN-SOFTWARE-15 ;
  voag:hasClause voag:CLS_OPEN-SOFTWARE-16 ;
  voag:incompatibleWith voag:GNU-GPL_V3 ;
  voag:url "http://www.opensource.org/licenses/osl-3.0.php"^^xsd:anyURI .

voag:CLS_OPEN-SOFTWARE-01
  a voag:CopyrightGrantClause ;
  dcterms:description """Licensor grants You a worldwide, royalty-free, non-exclusive, sublicensable license, for the duration of the copyright, to do the following:

a) to reproduce the Original Work in copies, either alone or as part of a collective work;

b) to translate, adapt, alter, transform, modify, or arrange the Original Work, thereby creating derivative works ("Derivative Works") based upon the Original Work;

c) to distribute or communicate copies of the Original Work and Derivative Works to the public, with the proviso that copies of Original Work or Derivative Works that You distribute or communicate shall be licensed under this Open Software License;

d) to perform the Original Work publicly; and

e) to display the Original Work publicly.""" ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-open-software> ;
  rdfs:label "Open Software License, all versions through 3.0 - Grant of Copyright License" ;
  voag:clauseNumber 1 ;
  voag:title "Grant of Copyright License" .

