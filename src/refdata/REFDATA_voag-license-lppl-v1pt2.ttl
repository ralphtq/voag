  vaem:title "VOAG License: LaTeX Project Public License 1.2 - Version $$VERSION$$" ;
  vaem:turtleFileURL "http://voag.linkedmodel.org/$$VERSION$$/refdata/REFDATA_voag-license-lppl-v1pt2-v$$VERSION$$.ttl"^^xsd:anyURI ;
