  rdfs:label "Perl Foundation Artistic License 2.0 Clause 06: Distribution of Compiled Forms of the Standard Version or Modified Versions without the Source" ;
  vaem:description "<p>You may Distribute a Modified Version in Compiled form without the Source, provided that you comply with Section 4 with respect to the Source of the Modified Version.</p>"^^rdf:HTML ;
