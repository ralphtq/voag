@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/voag/> .

<http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-modified-bsd>
  a owl:Ontology ;
  owl:imports <http://voag.linkedmodel.org/$$VERSION$$/schema/shacl/voag> ;
  vaem:hasGraphMetadata voag:GMD_VOAG-LICENSE-MODIFIED-BSD .

dcterms:author
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "author" ;
  rdfs:range xsd:string .

dcterms:created
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "created" ;
  rdfs:range xsd:date .

dcterms:modified
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "modified" ;
  rdfs:range xsd:date .

dcterms:subject
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

dcterms:title
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "title" ;
  rdfs:range xsd:string .

dcterms:description
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

voag:GMD_VOAG-LICENSE-MODIFIED-BSD
  a vaem:GraphMetaData ;
  dcterms:author "Ralph Hodgson" ;
  dcterms:created "2026-11-18"^^xsd:date ;
  dcterms:description "Modified BSD license, described in the Vocabulary Of Attribution and Governance (VOAG). The clause text is taken from the SPDX License List (BSD-3-Clause)." ;
  dcterms:modified "$$RELEASE_DATE$$"^^xsd:date ;
  dcterms:source <https://spdx.org/licenses/BSD-3-Clause.html> ;
  dcterms:subject "Licensing, Attribution, Governance and Provenance" ;
  dcterms:title "VOAG License: Modified BSD license - Version $$VERSION$$" ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-modified-bsd> ;
  rdfs:label "VOAG License: Modified BSD license - Version $$VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:hasLicenseType voag:CCBY-4PT0-LICENSE ;
  vaem:hasOwner vaem:LinkedModels ;
  vaem:hasSteward vaem:LinkedModels ;
  vaem:name "voag" ;
  vaem:namespace "http://voag.linkedmodel.org/voag/" ;
  vaem:namespacePrefix "voag" ;
  vaem:owner "Linkedmodels" ;
  vaem:revision "$$VERSION$$" ;
  vaem:title "VOAG License: Modified BSD license - Version $$VERSION$$" ;
  vaem:turtleFileURL "http://voag.linkedmodel.org/$$VERSION$$/refdata/REFDATA_voag-license-modified-bsd-v$$VERSION$$.ttl"^^xsd:anyURI ;
  vaem:withAttributionTo voag:LinkedModelsAttribution .

voag:MODIFIED-BSD-LICENSE
