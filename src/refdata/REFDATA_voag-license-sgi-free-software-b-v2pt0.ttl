  voag:hasClause voag:CLS_SGI-FREE-SOFTWARE-B_V2PT0-02 ;
  voag:hasClause voag:CLS_SGI-FREE-SOFTWARE-B_V2PT0-03 ;
  voag:hasClause voag:CLS_SGI-FREE-SOFTWARE-B_V2PT0-04 ;
  voag:url "http://oss.sgi.com/projects/FreeB/"^^xsd:anyURI .

