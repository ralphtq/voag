  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "modified" ;
  rdfs:range xsd:date .

dcterms:subject
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

