  dcterms:source <https://spdx.org/licenses/BSD-4-Clause.html> ;
  dcterms:subject "Licensing, Attribution, Governance and Provenance" ;
  dcterms:title "VOAG License: Original BSD license - Version $$VERSION$$" ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-bsd-original> ;
  rdfs:label "VOAG License: Original BSD license - Version $$VERSION$$" ;
