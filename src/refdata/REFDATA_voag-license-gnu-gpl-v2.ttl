@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/voag/> .

<http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-gnu-gpl-v2>
  a owl:Ontology ;
  owl:imports <http://voag.linkedmodel.org/$$VERSION$$/schema/shacl/voag> ;
  vaem:hasGraphMetadata voag:GMD_VOAG-LICENSE-GNU-GPL-V2 .

dcterms:author
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "author" ;
  rdfs:range xsd:string .

dcterms:created
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "created" ;
  rdfs:range xsd:date .

dcterms:modified
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "modified" ;
  rdfs:range xsd:date .

dcterms:subject
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

dcterms:title
  a rdf:Property ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "title" ;
  rdfs:range xsd:string .

dcterms:description
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

voag:GMD_VOAG-LICENSE-GNU-GPL-V2
  a vaem:GraphMetaData ;
  dcterms:author "Ralph Hodgson" ;
  dcterms:created "2026-11-18"^^xsd:date ;
  dcterms:description "GNU General Public License (GPL) version 2, described in the Vocabulary Of Attribution and Governance (VOAG)." ;
  dcterms:modified "$$RELEASE_DATE$$"^^xsd:date ;
  dcterms:subject "Licensing, Attribution, Governance and Provenance" ;
  dcterms:title "VOAG License: GNU General Public License (GPL) version 2 - Version $$VERSION$$" ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-gnu-gpl-v2> ;
  rdfs:label "VOAG License: GNU General Public License (GPL) version 2 - Version $$VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:hasLicenseType voag:CCBY-4PT0-LICENSE ;
  vaem:hasOwner vaem:LinkedModels ;
  vaem:hasSteward vaem:LinkedModels ;
  vaem:name "voag" ;
  vaem:namespace "http://voag.linkedmodel.org/voag/" ;
  vaem:namespacePrefix "voag" ;
  vaem:owner "Linkedmodels" ;
  vaem:revision "$$VERSION$$" ;
  vaem:title "VOAG License: GNU General Public License (GPL) version 2 - Version $$VERSION$$" ;
  vaem:turtleFileURL "http://voag.linkedmodel.org/$$VERSION$$/refdata/REFDATA_voag-license-gnu-gpl-v2-v$$VERSION$$.ttl"^^xsd:anyURI ;
  vaem:withAttributionTo voag:LinkedModelsAttribution .

voag:GNU-GPL_V2
  a voag:License ;
  prov:wasDerivedFrom voag:GNU-GPL ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-gnu-gpl-v2> ;
  rdfs:label "GNU General Public License (GPL) version 2" ;
