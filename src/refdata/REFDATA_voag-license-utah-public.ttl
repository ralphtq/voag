<http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-utah-public>
  a owl:Ontology ;
  owl:imports <http://voag.linkedmodel.org/$$VERSION$$/schema/shacl/voag> ;
  vaem:hasGraphMetadata voag:GMD_VOAG-LICENSE-UTAH-PUBLIC .

dcterms:author
  a rdf:Property ;
