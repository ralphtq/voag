  vaem:description "This is a free software license and is GPL compatible." ;
  voag:compatibleWith voag:GNU-GPL_V3 ;
  voag:hasClause voag:CLS_W3C_SOFTWARE-01 ;
  voag:hasClause voag:CLS_W3C_SOFTWARE-02 ;
  voag:hasClause voag:CLS_W3C_SOFTWARE-03 ;
  voag:url "http://www.w3.org/Consortium/Legal/2002/copyright-software-20021231"^^xsd:anyURI .

