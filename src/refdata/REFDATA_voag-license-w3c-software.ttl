  dcterms:created "2026-11-18"^^xsd:date ;
  dcterms:description "W3C Software Notice and License, described in the Vocabulary Of Attribution and Governance (VOAG). The clause text is taken from the SPDX License List (W3C)." ;
  dcterms:modified "$$RELEASE_DATE$$"^^xsd:date ;
  dcterms:source <https://spdx.org/licenses/W3C.html> ;
  dcterms:subject "Licensing, Attribution, Governance and Provenance" ;
  dcterms:title "VOAG License: W3C Software Notice and License - Version $$VERSION$$" ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-w3c-software> ;
  rdfs:label "VOAG License: W3C Software Notice and License - Version $$VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:hasLicenseType voag:CCBY-4PT0-LICENSE ;
  vaem:hasOwner vaem:LinkedModels ;
  vaem:hasSteward vaem:LinkedModels ;
  vaem:name "voag" ;
  vaem:namespace "http://voag.linkedmodel.org/voag/" ;
  vaem:namespacePrefix "voag" ;
  vaem:owner "Linkedmodels" ;
  vaem:revision "$$VERSION$$" ;
  vaem:title "VOAG License: W3C Software Notice and License - Version $$VERSION$$" ;
  vaem:turtleFileURL "http://voag.linkedmodel.org/$$VERSION$$/refdata/REFDATA_voag-license-w3c-software-v$$VERSION$$.ttl"^^xsd:anyURI ;
  vaem:withAttributionTo voag:LinkedModelsAttribution .

voag:W3C_SOFTWARE-LICENSE
