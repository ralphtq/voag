voag:GMD_VOAG-LICENSE-LPPL-V1PT2
  a vaem:GraphMetaData ;
  dcterms:author "Ralph Hodgson" ;
  dcterms:created "2026-11-18"^^xsd:date ;
  dcterms:description "LaTeX Project Public License 1.2, described in the Vocabulary Of Attribution and Governance (VOAG)." ;
  dcterms:modified "$$RELEASE_DATE$$"^^xsd:date ;
  dcterms:subject "Licensing, Attribution, Governance and Provenance" ;
  dcterms:title "VOAG License: LaTeX Project Public License 1.2 - Version $$VERSION$$" ;
  rdfs:isDefinedBy <http://voag.linkedmodel.org/$$VERSION$$/refdata/voag-license-lppl-v1pt2> ;
  rdfs:label "VOAG License: LaTeX Project Public License 1.2 - Version $$VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
