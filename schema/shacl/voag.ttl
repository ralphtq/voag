voag:GMD_VOAG a vaem:GraphMetaData ;
    rdfs:label "Schema for \"Vocabulary Of Attribution and Governance (VOAG)\" - Version 2.0"^^xsd:string ;
    dcterms:modified "2015-03-31"^^xsd:date ;
    dcterms:subject "Licensing, Attribution and Governance"^^xsd:string ;
    dcterms:title "Schema for \"Vocabulary Of Attribution and Governance (VOAG)\" - Version 2.0"^^xsd:string ;
    vaem:description """VOAG stands for <i>Vocabulary Of Attribution and Governance</i>. The ontology is intended to specify licensing, attribution, provenance and governance of an ontology.  A miminal model of governance defines how issues, releases and changes are managed. VOAG does not import, but makes uses of some concepts from <a href="http://vocab.deri.ie/void">VOID</a>, notably <code class="boxed">void:Dataset</code>.  Provenance is defined in terms of source and pedigree. Some use of <a href="http://www.w3.org/TR/prov-o/">PROVO</a>, the W3C provenance ontology, is made, but not by import.

The VOAG schema has a companion VOAG reference data graph that holds license types. This specifies many common license types and their restrictions. Where a license requires attribution, VOAG provides resources that allow the attribution should be made. Documentation of this graph can be found at <a href="http://voag.linkedmodel.org/doc/2015/REFDATA_voag-license-types-v2.0.html">VOAG Licenses Documentation</a>."""^^xsd:string ;
    vaem:hasGraphRole vaem:SchemaGraph ;
    vaem:hasLicenseType <http://voag.linkedmodel.org/voag#CC-SHAREALIKE_3PT0-US> ;
    vaem:hasOwner vaem:TopQuadrant ;
    vaem:hasSteward vaem:TopQuadrant ;
    vaem:intent "VOAG is a schema for intellectual capital rights, attribution and governance. Uses the PROVO ontology for provenance.  Typical use of the ontology is to refer to its resources, as opposed to importing the ontology."^^xsd:string ;
    vaem:latestPublishedVersion "http://voag.linkedmodel.org/2.0/doc/2015/SCHEMA_voag-v2.0.html"^^xsd:anyURI ;
    vaem:logo "http://www.linkedmodel.org/lib/lm/images/logos/voag_logo_360x110.png"^^xsd:anyURI ;
    vaem:name "voag"^^xsd:string ;
    vaem:namespace "http://voag.linkedmodel.org/voag/"^^xsd:anyURI ;
    vaem:namespacePrefix "voag"^^xsd:string ;
    vaem:owner "TopQuadrant, Inc."^^xsd:string ;
    vaem:previousPublishedVersion "http://linkedmodel.org/doc/voag/1.0/"^^xsd:anyURI ;
    vaem:rdfxmlFileURL "http://voag.linkedmodel.org/2.0/schema/SCHEMA_voag-v2.0.rdf"^^xsd:anyURI ;
    vaem:revision "2.0"^^xsd:string ;
    vaem:title "Vocabulary Of Attribution and Governance (VOAG) Schema Version 2.0"^^xsd:string ;
    vaem:turtleFileURL "http://voag.linkedmodel.org/2.0/schema/SCHEMA_voag-v2.0.ttl"^^xsd:anyURI ;
    vaem:usesNonImportedResource dcterms:author,
        dcterms:contributor,
        dcterms:description,
        dcterms:subject,
        dcterms:title,
        voag:TopQuadrantAttribution,
        prov:Entity,
        prov:wasInfluencedBy ;
    vaem:withAttributionTo voag:TopQuadrantAttribution ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/2.0/schema/voag>,
        <http://voag.linkedmodel.org/schema/voag> ;
    rdfs:seeAlso <http://voag.linkedmodel.org/2.0/doc/2015/VOCAB_voag-v2.0.html> .

